[Unit]
Description=HATO ERP - Monthly Isolated Backup Restoration Verification
Documentation=file:///home/joeman/Documents/proyects/erp-hacienda/docs/BACKUPS.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=hato-backup
Group=hato-backup
EnvironmentFile=-/etc/hato-backup/backup.env
ExecStart=/usr/local/bin/hato-restore-check
TimeoutStartSec=3600
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/backups/hato-db /tmp /var/log
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
