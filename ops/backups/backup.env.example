# Variables de entorno para el servicio hato-backup (Art. 2 / ADR-0034 / ADR-0036)
# Instalar en el servidor como: /etc/hato-backup/backup.env
# Permisos requeridos: 600, propietario hato-backup:hato-backup
#
# ADVERTENCIA: Este archivo contiene credenciales operativas. NUNCA commitear valores reales.

ENVIRONMENT=production
BACKUP_DIR=/var/backups/hato-db
BACKUP_LOCK_FILE=/var/lock/hato-backup.lock

# Base de datos
POSTGRES_CONTAINER=hato-postgres
POSTGRES_DB=hato_production
PRODUCTION_POSTGRES_BACKUP_USER=hato_backup
PRODUCTION_POSTGRES_BACKUP_PASSWORD=CAMBIAR_EN_PRODUCCION

# Configuración rclone
RCLONE_CONFIG=/etc/hato-backup/rclone.conf
RCLONE_REMOTE=hato-crypt
REMOTE_NAMESPACE=database/prod/daily

# Límite compartido de Google Drive (300 GB decimales = 300 000 000 000 bytes)
DRIVE_SHARED_LIMIT_BYTES=300000000000
DRIVE_WARN_THRESHOLD_BYTES=210000000000
DRIVE_ALERT_THRESHOLD_BYTES=255000000000

# Políticas de retención
RETENTION_LOCAL_DAYS=7
RETENTION_REMOTE_DAILY_DAYS=30
RETENTION_REMOTE_MONTHLY_MONTHS=12

# Monitorización externa (Healthchecks autohospedado en home-server)
# Secret ping URLs (dejar vacío si no está configurado aún)
HEALTHCHECKS_PING_URL=https://hc.ejemplo.ts.net/ping/EJEMPLO_UUID_SECRETO
HEALTHCHECKS_RESTORE_PING_URL=https://hc.ejemplo.ts.net/ping/EJEMPLO_UUID_RESTORE_SECRETO
