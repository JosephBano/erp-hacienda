# ops/production/production.env.example
# Plantilla de production.env — NUNCA commitear el archivo real.
# El archivo real vive fuera del checkout, con permisos 600 y propietario
# root (spec.md sec. 5 "Custodia de credenciales"): JWT, contraseñas DB y
# credenciales equivalentes van en "Archivos 600 root-owned fuera del
# checkout", consumidos por los servicios concretos. Se carga con
# `docker compose -f compose.production.yml --env-file /etc/hato-production/production.env ...`
# Copia este archivo, complétalo fuera del repo y bórralo de cualquier lugar
# donde lo hayas editado en texto plano una vez cargado.

# ------------------------------------------------------------------------
# PostgreSQL — roles separados (spec.md sec. 4). Tres identidades distintas,
# nunca la misma contraseña reutilizada entre roles.
# ------------------------------------------------------------------------

# Rol owner/migrador: único con DDL. Usado solo por el servicio `migrate` y
# para el arranque inicial del contenedor `postgres` (ver TODO de creación de
# roles en compose.production.yml, servicio `postgres`).
PRODUCTION_POSTGRES_OWNER_USER=<REEMPLAZAR>
PRODUCTION_POSTGRES_OWNER_PASSWORD=<REEMPLAZAR>

# Rol runtime: DML mínimo, SIN superusuario, SIN DDL. Usado por el servicio
# `api`. Debe crearse mediante el mecanismo pendiente descrito en
# compose.production.yml (migración EF Core o script de inicialización) antes
# de completar este valor con un rol real.
PRODUCTION_POSTGRES_RUNTIME_USER=<REEMPLAZAR>
PRODUCTION_POSTGRES_RUNTIME_PASSWORD=<REEMPLAZAR>

# Rol backup: solo lectura, para el proceso de backup de feature-0013. No lo
# consume ningún servicio de este compose; se documenta aquí porque el
# mecanismo de creación de roles pendiente debe provisionarlo junto a los
# otros dos.
PRODUCTION_POSTGRES_BACKUP_USER=<REEMPLAZAR>
PRODUCTION_POSTGRES_BACKUP_PASSWORD=<REEMPLAZAR>

# ------------------------------------------------------------------------
# JWT — signing key/issuer/audience propios de producción (spec.md sec. 4:
# "Production debe fallar si faltan secretos"). La API ya valida al arrancar
# que Jwt:SigningKey tenga al menos 32 caracteres (ver
# src/Modules/People/Hato.Modules.People.Infrastructure/PeopleModule.cs).
# ------------------------------------------------------------------------
PRODUCTION_JWT_ISSUER=<REEMPLAZAR>
PRODUCTION_JWT_AUDIENCE=<REEMPLAZAR>
# Genera con, por ejemplo: openssl rand -base64 48
PRODUCTION_JWT_SIGNING_KEY=<REEMPLAZAR>

# ------------------------------------------------------------------------
# Red — único binding de entrada del stack (spec.md sec. 4). Nunca 0.0.0.0 ni
# una IP real hardcodeada en el repo; el valor real vive solo en el
# production.env fuera del checkout.
# ------------------------------------------------------------------------
TAILSCALE_IP=<REEMPLAZAR>

# ------------------------------------------------------------------------
# Trazabilidad del build (mismo patrón que compose.staging.yml / .env de
# staging). El workflow de despliegue los escribe desde el release etiquetado
# (spec.md sec. 6); no se completan a mano salvo prueba manual puntual.
# ------------------------------------------------------------------------
HATO_VERSION=
HATO_COMMIT=
HATO_BUILD_DATE=
