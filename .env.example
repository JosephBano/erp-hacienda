# Copia este archivo a `.env` (que está en .gitignore) y completa los valores locales.
# Ninguna credencial real vive en el repositorio, ni siquiera las de desarrollo.

# Contraseña del PostgreSQL de desarrollo que levanta docker-compose.
# Elige cualquiera; solo vive en tu máquina.
POSTGRES_PASSWORD=

# Puerto del PostgreSQL en tu máquina (host port mapeado al 5432 interno del contenedor).
# Cámbialo si 5432 ya está ocupado en tu equipo; el backend se conecta al interno 5432
# por la red de compose, así que el valor de aquí no requiere tocar código.
# Valor típico: 5432. Si choca con otro servicio, usa 5433, 5434, etc.
POSTGRES_PORT=5432

# Puerto del panel web (admin-web) en tu máquina. Cámbialo si 4200 está ocupado.
WEB_PORT=4200
