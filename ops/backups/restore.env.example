# Configuración exclusiva del simulacro mensual en home-server.
# Instalar como /etc/hato-restore/restore.env con root:root y modo 600.
# Nunca instalar este archivo en Oracle: el restore no debe tener acceso al origen.

RCLONE_CONFIG=/etc/hato-restore/rclone.conf
RCLONE_REMOTE=hato-crypt
REMOTE_NAMESPACE=database/prod/daily
HEALTHCHECKS_RESTORE_PING_URL=https://hc.ejemplo.ts.net/ping/EJEMPLO_UUID_RESTORE_SECRETO

# El compose crea este PostgreSQL efímero y aislado, sin puertos publicados.
RESTORE_COMPOSE_FILE=/opt/hato-restore/hato-restore-check.compose.yml
RESTORE_POSTGRES_CONTAINER=hato-restore-check-postgres
RESTORE_POSTGRES_USER=hato_restore
RESTORE_POSTGRES_PASSWORD=CAMBIAR_EN_HOME_SERVER
