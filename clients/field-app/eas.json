{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "extends": "base",
      "distribution": "internal",
      "developmentClient": true,
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_APP_VARIANT": "development",
        "EXPO_PUBLIC_API_URL": "http://10.0.2.2:5282"
      }
    },
    "stage": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "stage",
        "EXPO_PUBLIC_APP_VARIANT": "stage",
        "EXPO_PUBLIC_API_URL": "https://joemanserver.ts.net/api"
      }
    },
    "preview": {
      "extends": "stage"
    },
    "production": {
      "extends": "base",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_APP_VARIANT": "production",
        "EXPO_PUBLIC_API_URL": "https://hato-oracle.ts.net/api"
      }
    },
    "base": {
      "node": "20.19.4",
      "env": {
        "NODE_ENV": "production"
      }
    }
  }
}
